# =================================================================
# PrepWise AI Platform — Environment Configuration Template
# Copy this file to '.env' and fill in your custom API keys.
# =================================================================

# 1. SERVER & SECURITY CONFIGURATION
PORT=5000
FLASK_ENV=development
SECRET_KEY=your_secret_key_here
DATABASE_URL=sqlite:///prepwise.db

# 2. FRONTEND API CONNECTION
VITE_API_BASE_URL=http://localhost:5000

# 3. THIRD-PARTY RESUME PARSER API KEYS (OPTIONAL ENTERPRISE HOOKS)
AFFINDA_API_KEY=your_affinda_key_here
RCHILLI_USER_KEY=your_rchilli_user_key_here
TEXTKERNEL_ACCOUNT_ID=your_textkernel_account_id
TEXTKERNEL_SERVICE_KEY=your_textkernel_service_key

# 4. AI & LLM MOCK INTERVIEW API KEYS
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 5. DATASET PATHS
DATASET_JOBS_PATH=data/jobs/jobs_dataset.csv
DATASET_RESUMES_PATH=data/resumes/Resume.csv
